{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: tauri: ws: wss:; img-src 'self' data: asset: tauri:; font-src 'self' data:"
    },
    "windows": [
      {
        "title": "markdn",
        "width": 1400,
        "fullscreen": false,
        "height": 900,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 14, "y": 19 }
      }
    ],
    "withGlobalTauri": true
  },
  "build": {
    "devUrl": "http://localhost:43118",
    "frontendDist": "loading"
  },
  "bundle": {
    "active": true,
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "externalBin": [
      "../burrito_out/desktop"
    ],
    "resources": {
      "cli/markdn": "cli/markdn"
    },
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdx"],
        "name": "Markdown document",
        "description": "Markdown or MDX document",
        "role": "Editor",
        "mimeType": "text/markdown"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": "all"
  },
  "identifier": "app.markdn.desktop",
  "productName": "markdn",
  "version": "0.1.0"
}
